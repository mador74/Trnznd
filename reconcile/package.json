{
  "name": "stablecoin-reconcile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based reconciliation of USDT/USDC settlements (Ethereum, Solana, Tron) against payment requests.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "publish:pages": "npm run build && rm -rf ../docs/reconcile && cp -r dist ../docs/reconcile",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "idb-keyval": "^6.2.1",
    "papaparse": "^5.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
